(package "networkmanager" "1.48"
  (description "Network connection manager and user applications")
  (license "GPL-2.0-or-later")
  (homepage "https://networkmanager.dev")

  (acquire
    (source "https://download.gnome.org/sources/NetworkManager/1.48/NetworkManager-1.48.0.tar.xz"
      (sha256 "todo-compute-actual-hash")))

  (build-deps
    (meson)
    (ninja)
    (pkg-config))

  (deps
    (systemd)
    (util-linux))

  (build
    (steps
      (configure "meson setup build --prefix=$PREFIX")
      (compile "ninja -C build")))

  (install
    (shell "DESTDIR=$PREFIX ninja -C build install")))
