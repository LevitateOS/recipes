const NEEDS = #{
    outputs: #{ tools: "directory" },
    network: ["go.dev:443", "dl.google.com:443"],
    network_max_bytes: 81461248,
    memory_mib: 4096,
    storage_max_objects: 131072,
    timeout_secs: 1800,
};

// Build dependencies are hidden library entries until the catalog has a toolchain kind.
const ABOUT = #{
    kind: "library",
    category: "development",
    details: "Compiles Go programs inside the Recipe sandbox with the pinned compiler and standard library. The go launcher selects this bundled toolchain and disables automatic toolchain downloads.",
    homepage: "https://go.dev",
    license: "BSD-3-Clause",
    steps: #{
        acquire: "Downloads the pinned toolchain files and checks their SHA-256 values.",
        build: "Extracts the release and checks every regular file against the committed payload manifest.",
        install: "Publishes a private tools directory for recipes that name this under build_deps.",
    },
};

let ctx = #{
    name: "go",
    version: "1.27.4",
    description: "Go compiler and standard library",
    downloads: join_path(RUNTIME.paths.build, "downloads"),
    unpacked: join_path(RUNTIME.paths.build, "unpacked"),
    tools: join_path(RUNTIME.paths.build, "unpacked"),
    manifest: join_path(RUNTIME.paths.temp, "go.sha256"),
    manifest_sha256: "937345eeeee55a6dfc5c90d733924cf75afb43890829982816ac0b4531bc1ef7",
    source_subdir: "",
    probe: "bin/go",
    sources: [
        #{ url: "https://go.dev/dl/go1.27.4.linux-amd64.tar.gz",
           archive: "go1.27.4.linux-amd64.tar.gz", sha256: "7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840",
           format: "tar.gz", destination: "" },
    ],
};
// Setup stages the literal payload manifest in owned temporary storage.
write_file(ctx.manifest, FILE_SHA256);
ctx.launcher = GO_LAUNCHER;

fn check_payload(ctx, root) {
    if !is_file(join_path(root, ctx.probe)) {
        return needs_work(ctx, "missing " + ctx.name + " toolchain");
    }
    verify_sha256(ctx.manifest, ctx.manifest_sha256);
    exec_checked("sha256sum", ["--check", "--status", ctx.manifest], #{ cwd: root });
    let version = exec_output(join_path(root, "bin/go"), ["version"], #{ env: #{ GOMAXPROCS: "1" } });
    if !starts_with(version, "go version go1.27.4") { throw "unexpected go tool version: " + version; }
    log(trim(version));
    ready(ctx)
}

fn is_acquired(ctx) {
    for source in ctx.sources {
        let path = join_path(ctx.downloads, source.archive);
        if !is_file(path) { return needs_work(ctx, "download " + source.archive); }
        verify_sha256(path, source.sha256);
    }
    ready(ctx)
}
fn acquire(ctx) {
    mkdir(ctx.downloads);
    for source in ctx.sources {
        download(source.url, join_path(ctx.downloads, source.archive), source.sha256);
    }
    ctx
}
fn is_built(ctx) {
    check_payload(ctx, join_path(ctx.unpacked, ctx.source_subdir))
}
fn build(ctx) {
    if exists(ctx.unpacked) { rm(ctx.unpacked); }
    mkdir(ctx.unpacked);
    for source in ctx.sources {
        let archive = join_path(ctx.downloads, source.archive);
        verify_sha256(archive, source.sha256);
        if source.format == "rpm" {
            target_extract_rpm(archive, ctx.unpacked);
        } else if source.format == "file" {
            let destination = join_path(ctx.unpacked, source.destination);
            mkdir(dirname(destination));
            copy_file(archive, destination);
        } else {
            extract_with_format(archive, ctx.unpacked, source.format);
        }
    }
    // Compiler/stdlib build inputs do not include upstream test fixtures,
    // including intentionally published private keys used by Go's tests.
    exec_checked("find", [join_path(ctx.unpacked, "go/src"), "-type", "d", "-name", "testdata", "-prune", "-exec", "rm", "-rf", "{}", ";"]);
    exec_checked("find", [join_path(ctx.unpacked, "go"), "-type", "f", "-name", "*_test.go", "-delete"]);
    rm(join_path(ctx.unpacked, "go/test"));
    rm(join_path(ctx.unpacked, "go/src/crypto/x509/platform_root_key.pem"));
    rm(join_path(ctx.unpacked, "go/src/crypto/x509/platform_root_cert.pem"));
    mkdir(join_path(ctx.unpacked, "lib"));
    exec_checked("mv", [join_path(ctx.unpacked, "go"), join_path(ctx.unpacked, "lib/go")]);
    mkdir(join_path(ctx.unpacked, "bin"));
    write_file(join_path(ctx.unpacked, "bin/go"), ctx.launcher);
    chmod(join_path(ctx.unpacked, "bin/go"), 0o755);
    copy_file(join_path(ctx.unpacked, "lib/go/bin/gofmt"), join_path(ctx.unpacked, "bin/gofmt"));
    chmod(join_path(ctx.unpacked, "bin/gofmt"), 0o755);
    ctx
}
fn is_installed(ctx) {
    if !is_file(join_path(ctx.tools, ctx.probe)) {
        return needs_work(ctx, "publish " + ctx.name + " tools");
    }
    ctx.outputs.tools = ctx.tools;
    check_payload(ctx, ctx.tools)
}
fn install(ctx) {
    // The verified SDK is already in owned storage; publish it without a second copy.
    ctx.outputs.tools = ctx.tools;
    ctx
}
fn remove(ctx) {
    if exists(ctx.tools) { rm(ctx.tools); }
    ctx.outputs = #{};
    ctx
}
