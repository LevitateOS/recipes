(package "util-linux" "2.40"
  (description "Miscellaneous system utilities (mount, fdisk, lsblk, etc.)")
  (license "GPL-2.0")
  (homepage "https://github.com/util-linux/util-linux")

  (acquire
    (source "https://www.kernel.org/pub/linux/utils/util-linux/v2.40/util-linux-2.40.tar.xz"
      (sha256 "todo-compute-actual-hash")))

  (build
    (steps
      (configure "./configure --prefix=$PREFIX --disable-all-programs --enable-mount --enable-fdisk --enable-lsblk --enable-blkid --enable-losetup")
      (compile "make -j$NPROC")))

  (install
    (shell "make DESTDIR=$PREFIX install")))
