(package "systemd" "256"
  (description "System and service manager for Linux")
  (license "LGPL-2.1-or-later")
  (homepage "https://systemd.io")

  (acquire
    (source "https://github.com/systemd/systemd/archive/refs/tags/v256.tar.gz"
      (sha256 "todo-compute-actual-hash")))

  (build-deps
    (meson)
    (ninja)
    (pkg-config)
    (gperf)
    (python3))

  (deps
    (util-linux)
    (bash))

  (build
    (steps
      (configure "meson setup build --prefix=$PREFIX -Dmode=release")
      (compile "ninja -C build")))

  (install
    (shell "DESTDIR=$PREFIX ninja -C build install")))
