const NEEDS = #{
    outputs: #{ tools: "directory" },
    network: ["dl.rockylinux.org:443", "raw.githubusercontent.com:443"],
    network_max_bytes: 22937600,
    memory_mib: 4096,
    storage_max_objects: 131072,
    timeout_secs: 600,
};

// Build dependencies are hidden library entries until the catalog has a toolchain kind.
const ABOUT = #{
    kind: "library",
    category: "development",
    details: "Adds the matching Rocky GCC C++ frontend, standard library and headers to the shared Recipe build image. It requires that image to provide GCC 14.3.1, its C headers and linker.",
    homepage: "https://gcc.gnu.org",
    license: "GPL-3.0-or-later AND (GPL-3.0-or-later WITH GCC-exception-3.1)",
    steps: #{
        acquire: "Downloads the pinned toolchain files and checks their SHA-256 values.",
        build: "Extracts the release and checks every regular file against the committed payload manifest.",
        install: "Publishes a private tools directory for recipes that name this under build_deps.",
    },
};

let ctx = #{
    name: "gxx",
    version: "14.3.1-4.4.el10",
    description: "C++ frontend and headers for the GCC 14 build image",
    downloads: join_path(RUNTIME.paths.build, "downloads"),
    unpacked: join_path(RUNTIME.paths.build, "unpacked"),
    tools: join_path(RUNTIME.paths.output, "tools"),
    manifest: join_path(RUNTIME.paths.temp, "gxx.sha256"),
    manifest_sha256: "4c6026ddee67b70ea66e200d547cb540ae88b3b26ac1e6a9d74a7ab8363a17e4",
    source_subdir: "",
    probe: "usr/bin/g++",
    links: [
        ["usr/lib/.build-id/03/6c36821268e72cdd07e8ffd9adbf8909c87b14", "../../../../usr/libexec/gcc/x86_64-redhat-linux/14/cc1plus"],
        ["usr/lib/.build-id/26/6d50f786ffd40128693a6c69913480f6d82944", "../../../../usr/lib64/libstdc++.so.6.0.33"],
        ["usr/lib/.build-id/50/c2a3f69bcd0bfb11080c9d1e13abe8ccf5d4db", "../../../../usr/bin/x86_64-redhat-linux-c++"],
        ["usr/lib/.build-id/50/c2a3f69bcd0bfb11080c9d1e13abe8ccf5d4db.1", "../../../../usr/bin/x86_64-redhat-linux-g++"],
        ["usr/lib/.build-id/50/c2a3f69bcd0bfb11080c9d1e13abe8ccf5d4db.2", "../../../../usr/bin/g++"],
        ["usr/lib/.build-id/50/c2a3f69bcd0bfb11080c9d1e13abe8ccf5d4db.3", "../../../../usr/bin/c++"],
        ["usr/lib/.build-id/b6/43bb315ba43c72f8ee75878c90eaea725567b2", "../../../../usr/libexec/gcc/x86_64-redhat-linux/14/g++-mapper-server"],
        ["usr/lib/gcc/x86_64-redhat-linux/14/libstdc++.so", "../../../../lib64/libstdc++.so.6.0.33"],
        ["usr/lib64/libstdc++.so.6", "libstdc++.so.6.0.33"],
    ],
    sources: [
        #{ url: "https://dl.rockylinux.org/pub/rocky/10.2/AppStream/x86_64/os/Packages/g/gcc-c++-14.3.1-4.4.el10.x86_64.rpm",
           archive: "gcc-c++-14.3.1-4.4.el10.x86_64.rpm", sha256: "3c7fdc3cef30a2f293e6f02e4fbf71019e9ff6db43e00e04d11127ea4363f6c4",
           format: "rpm", destination: "" },
        #{ url: "https://dl.rockylinux.org/pub/rocky/10.2/AppStream/x86_64/os/Packages/l/libstdc++-devel-14.3.1-4.4.el10.x86_64.rpm",
           archive: "libstdc++-devel-14.3.1-4.4.el10.x86_64.rpm", sha256: "7ce2f001978b0891c83c011e70443d318beaaf289cc670ae09d7aa25f6cab359",
           format: "rpm", destination: "" },
        #{ url: "https://dl.rockylinux.org/pub/rocky/10.2/BaseOS/x86_64/os/Packages/l/libstdc++-14.3.1-4.4.el10.x86_64.rpm",
           archive: "libstdc++-14.3.1-4.4.el10.x86_64.rpm", sha256: "342c4128ad2e04b518871c3029132405d0a8a36a94c0449262d08cc8350e62ba",
           format: "rpm", destination: "" },
        #{ url: "https://raw.githubusercontent.com/gcc-mirror/gcc/releases/gcc-14.3.0/COPYING3",
           archive: "COPYING3", sha256: "8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903",
           format: "file", destination: "share/licenses/gxx/COPYING3" },
        #{ url: "https://raw.githubusercontent.com/gcc-mirror/gcc/releases/gcc-14.3.0/COPYING.RUNTIME",
           archive: "COPYING.RUNTIME", sha256: "9d6b43ce4d8de0c878bf16b54d8e7a10d9bd42b75178153e3af6a815bdc90f74",
           format: "file", destination: "share/licenses/gxx/COPYING.RUNTIME" },
    ],
};
// Setup stages the literal payload manifest in owned temporary storage.
write_file(ctx.manifest, FILE_SHA256);

fn check_payload(ctx, root) {
    if !is_file(join_path(root, ctx.probe)) {
        return needs_work(ctx, "missing " + ctx.name + " toolchain");
    }
    verify_sha256(ctx.manifest, ctx.manifest_sha256);
    exec_checked("sha256sum", ["--check", "--status", ctx.manifest], #{ cwd: root });
    for link in ctx.links {
        let actual = trim(exec_output("readlink", [join_path(root, link[0])]));
        if actual != link[1] { throw "toolchain link changed: " + link[0]; }
    }
    ready(ctx)
}

fn is_acquired(ctx) {
    for source in ctx.sources {
        let path = join_path(ctx.downloads, source.archive);
        if !is_file(path) { return needs_work(ctx, "download " + source.archive); }
        verify_sha256(path, source.sha256);
    }
    ready(ctx)
}
fn acquire(ctx) {
    mkdir(ctx.downloads);
    for source in ctx.sources {
        download(source.url, join_path(ctx.downloads, source.archive), source.sha256);
    }
    ctx
}
fn is_built(ctx) {
    check_payload(ctx, join_path(ctx.unpacked, ctx.source_subdir))
}
fn build(ctx) {
    if trim(exec_output("gcc", ["-dumpfullversion"])) != "14.3.1" ||
        trim(exec_output("gcc", ["-dumpmachine"])) != "x86_64-redhat-linux" {
        throw "gxx requires the shared Rocky x86_64 GCC 14.3.1 compiler image";
    }
    if exists(ctx.unpacked) { rm(ctx.unpacked); }
    mkdir(ctx.unpacked);
    for source in ctx.sources {
        let archive = join_path(ctx.downloads, source.archive);
        verify_sha256(archive, source.sha256);
        if source.format == "rpm" {
            target_extract_rpm(archive, ctx.unpacked);
        } else if source.format == "file" {
            let destination = join_path(ctx.unpacked, source.destination);
            mkdir(dirname(destination));
            copy_file(archive, destination);
        } else {
            extract_with_format(archive, ctx.unpacked, source.format);
        }
    }
    if exists(join_path(ctx.unpacked, ".recipe-target-metadata.json")) {
        rm(join_path(ctx.unpacked, ".recipe-target-metadata.json"));
    }
    // The native toolchain does not include the i686 development libraries.
    rm(join_path(ctx.unpacked, "usr/lib/gcc/x86_64-redhat-linux/14/32"));
    ctx
}
fn is_installed(ctx) {
    if !is_file(join_path(ctx.tools, ctx.probe)) {
        return needs_work(ctx, "publish " + ctx.name + " tools");
    }
    ctx.outputs.tools = ctx.tools;
    check_payload(ctx, ctx.tools)
}
fn install(ctx) {
    if exists(ctx.tools) { rm(ctx.tools); }
    mkdir(ctx.tools);
    copy_tree_contents(join_path(ctx.unpacked, ctx.source_subdir), ctx.tools);
    ctx.outputs.tools = ctx.tools;
    ctx
}
fn remove(ctx) {
    if exists(ctx.tools) { rm(ctx.tools); }
    ctx.outputs = #{};
    ctx
}
