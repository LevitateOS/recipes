(package "coreutils" "9.5"
  (description "GNU core utilities (ls, cp, mv, cat, etc.)")
  (license "GPL-3.0")
  (homepage "https://www.gnu.org/software/coreutils/")

  (acquire
    (source "https://ftp.gnu.org/gnu/coreutils/coreutils-9.5.tar.xz"
      (sha256 "cd328edeac92f6a665de9f323c93b712af1858bc2e0d88f3f7100469470a1b8a")))

  (build
    (steps
      (configure "./configure --prefix=$PREFIX")
      (compile "make -j$NPROC")))

  (install
    (shell "make DESTDIR=$PREFIX install")))
